# OpenRouter API key for LLM-based dataset augmentation (optional)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model to use (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# HuggingFace Hub token for pushing datasets/models
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
